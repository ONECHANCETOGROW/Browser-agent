{
  "manifest_version": 3,
  "name": "OCTG Browser Agent",
  "version": "0.1.0",
  "description": "Generic, website-agnostic browser control for the local OCTG agent. Talks only to 127.0.0.1.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation",
    "sidePanel",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "OCTG Browser Agent"
  }
}
